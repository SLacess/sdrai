{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sales-os.local/schemas/reply_classifier.json",
  "title": "reply_classifier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "agent",
    "agentVersion",
    "status",
    "confidence",
    "facts",
    "inferences",
    "recommendedActions",
    "policyFlags",
    "modelMetadata",
    "createdAt",
    "classification"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "agent": {
      "type": "string"
    },
    "agentVersion": {
      "type": "string"
    },
    "entityId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "success",
        "partial",
        "blocked"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidenceId"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "confidence"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "basisEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "recommendedActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "rationale",
          "risk"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "GREEN",
              "YELLOW",
              "RED"
            ]
          }
        }
      }
    },
    "policyFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelMetadata": {
      "type": "object"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "object",
      "required": [
        "intent",
        "sentiment",
        "requiresHuman",
        "pauseSequence"
      ],
      "properties": {
        "intent": {
          "enum": [
            "UNKNOWN",
            "NEUTRAL",
            "INTERESTED",
            "POSITIVE_REPLY",
            "READY_TO_BUY",
            "REQUEST_INFO",
            "REQUEST_DEMO",
            "REQUEST_MEETING",
            "OBJECTION",
            "NOT_NOW",
            "NOT_INTERESTED",
            "OPT_OUT",
            "PROCUREMENT",
            "LEGAL",
            "SECURITY",
            "PRICING"
          ]
        },
        "sentiment": {
          "enum": [
            "POSITIVE",
            "NEUTRAL",
            "NEGATIVE",
            "MIXED",
            "UNKNOWN"
          ]
        },
        "objectionType": {
          "type": [
            "string",
            "null"
          ]
        },
        "requiresHuman": {
          "type": "boolean"
        },
        "pauseSequence": {
          "const": true
        }
      }
    }
  }
}