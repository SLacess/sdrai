{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sales-os.local/schemas/learning_analyst.json",
  "title": "learning_analyst",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "agent",
    "agentVersion",
    "status",
    "confidence",
    "facts",
    "inferences",
    "recommendedActions",
    "policyFlags",
    "modelMetadata",
    "createdAt",
    "proposals"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "agent": {
      "type": "string"
    },
    "agentVersion": {
      "type": "string"
    },
    "entityId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "success",
        "partial",
        "blocked"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidenceId"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "confidence"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "basisEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "recommendedActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "rationale",
          "risk"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "GREEN",
              "YELLOW",
              "RED"
            ]
          }
        }
      }
    },
    "policyFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelMetadata": {
      "type": "object"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "currentVersion",
          "proposal",
          "evidence",
          "expectedImpact",
          "risk",
          "requiresOfflineEval"
        ],
        "properties": {
          "type": {
            "enum": [
              "PROMPT",
              "WEIGHT",
              "THRESHOLD",
              "PLAYBOOK",
              "SEQUENCE"
            ]
          },
          "currentVersion": {
            "type": "string"
          },
          "proposal": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedImpact": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "requiresOfflineEval": {
            "const": true
          }
        }
      }
    }
  }
}