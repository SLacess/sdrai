{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sales-os.local/schemas/account_hunter.json",
  "title": "account_hunter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "agent",
    "agentVersion",
    "status",
    "confidence",
    "facts",
    "inferences",
    "recommendedActions",
    "policyFlags",
    "modelMetadata",
    "createdAt",
    "accounts"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "agent": {
      "type": "string"
    },
    "agentVersion": {
      "type": "string"
    },
    "entityId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "success",
        "partial",
        "blocked"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidenceId"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "confidence"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "basisEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "recommendedActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "rationale",
          "risk"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "GREEN",
              "YELLOW",
              "RED"
            ]
          }
        }
      }
    },
    "policyFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelMetadata": {
      "type": "object"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "brandName",
          "domain",
          "sourceUris"
        ],
        "properties": {
          "brandName": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "sourceUris": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "fitHints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}