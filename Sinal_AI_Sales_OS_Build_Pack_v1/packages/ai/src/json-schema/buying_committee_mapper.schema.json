{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sales-os.local/schemas/buying_committee_mapper.json",
  "title": "buying_committee_mapper",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "agent",
    "agentVersion",
    "status",
    "confidence",
    "facts",
    "inferences",
    "recommendedActions",
    "policyFlags",
    "modelMetadata",
    "createdAt",
    "contacts"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "agent": {
      "type": "string"
    },
    "agentVersion": {
      "type": "string"
    },
    "entityId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "success",
        "partial",
        "blocked"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidenceId"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "confidence"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "basisEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "recommendedActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "rationale",
          "risk"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "GREEN",
              "YELLOW",
              "RED"
            ]
          }
        }
      }
    },
    "policyFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelMetadata": {
      "type": "object"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "channel",
          "confidence",
          "sourceEvidenceIds"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "role": {
            "enum": [
              "DECISION_MAKER",
              "CHAMPION",
              "INFLUENCER",
              "TECHNICAL",
              "PROCUREMENT",
              "LEGAL",
              "UNKNOWN"
            ]
          },
          "channel": {
            "type": "object",
            "required": [
              "type",
              "address",
              "verified"
            ],
            "properties": {
              "type": {
                "enum": [
                  "EMAIL",
                  "LINKEDIN",
                  "PHONE"
                ]
              },
              "address": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sourceEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  }
}