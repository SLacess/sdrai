NODE_ENV=development
# Used by docker-compose.yml's postgres service; irrelevant if DATABASE_URL
# points at a managed Postgres instead of the containerized one.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://salesos:change-me@localhost:5432/salesos
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-me
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
APP_BASE_URL=http://localhost:3000
N8N_BASE_URL=http://localhost:5678
N8N_CALLBACK_SECRET=change-me
INBOUND_WEBHOOK_SECRET=change-me
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_WEBHOOK_SECRET=
# Optional: renders the HubSpot link on Account 360 (e.g. https://app.hubspot.com/contacts/<portalId>)
HUBSPOT_APP_BASE_URL=
EMAIL_PROVIDER=stub
EMAIL_API_KEY=
CALENDAR_PROVIDER=google
CALENDAR_CREDENTIAL_REF=
APIFY_TOKEN=
AI_PROVIDER_PRIMARY=
AI_API_KEY_PRIMARY=
SENTRY_DSN=
DEFAULT_TIMEZONE=America/Sao_Paulo
